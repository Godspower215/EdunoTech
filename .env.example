# Build-time (Cloudflare Pages > Settings > Variables, "Build" scope)
SITE_URL=https://www.your-domain.com
PUBLIC_TURNSTILE_SITE_KEY=

# Runtime secrets for functions/api/submit.ts (for local testing put these in .dev.vars)
RESEND_API_KEY=
MAIL_FROM=Eduno Tech Website <website@your-domain.com>
MAIL_TO=
MAIL_TO_ECIC=
TURNSTILE_SECRET_KEY=

# Submissions dashboard (/dashboard). Not secret; set in wrangler.jsonc "vars" or the dashboard.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=
# The D1 database is a binding named DB, configured in wrangler.jsonc.
