{
  // Cloudflare Workers config (static site + form handler).
  // Build command: npm run build   Deploy command: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edunotech",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The form handler and the private dashboard always go to the Worker code.
    "run_worker_first": ["/api/*", "/dashboard", "/dashboard/*"]
  },
  // Keep variables added in the Cloudflare dashboard when deploying from Git.
  "keep_vars": true,
  // Submissions database (Cloudflare D1, Storage & databases > D1).
  "d1_databases": [
    { "binding": "DB", "database_name": "edunotech-submissions", "database_id": "cc4222e2-f97b-456a-8b03-c552807b513e" }
  ],
  // Cloudflare Access settings for /dashboard (not secret). Filled in during setup.
  // "vars": {
  //   "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
  //   "ACCESS_AUD": "PASTE-AUD-TAG-HERE"
  // },
  // Required by Cloudflare's branch preview builds (npx wrangler preview).
  "previews": {},
  "observability": { "enabled": true }
}
