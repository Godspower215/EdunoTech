---
interface Props { title: string; text?: string; }
const { title, text } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band on-dark">
      <h2>{title}</h2>
      {text && <p>{text}</p>}
      <div class="btn-row"><slot /></div>
    </div>
  </div>
</section>
