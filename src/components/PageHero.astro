---
interface Props { eyebrow?: string; title: string; text?: string; dark?: boolean; }
const { eyebrow, title, text, dark = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--dark on-dark': dark }]}>
  <div class="page-hero__mark" aria-hidden="true"></div>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {text && <p class="lead">{text}</p>}
    <slot />
  </div>
</section>
