---
// Spam protection shared by every form: a hidden honeypot field (checked
// server-side) plus a Cloudflare Turnstile widget when PUBLIC_TURNSTILE_SITE_KEY
// is set. The Turnstile script itself is loaded once per page in Base.astro.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<div class="hp" aria-hidden="true">
  <label>Leave this field empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
</div>
{siteKey && (
  <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible" data-appearance={compact ? 'interaction-only' : 'always'}></div>
)}
