---
// Only renders when an official WhatsApp business number is set in site.json (blueprint 13.5).
import site from '../data/site.json';
import Icon from './Icon.astro';
import { waLink } from '../lib/contact';
const num = site.contact.whatsapp;
---
{num && (
  <a class="wa-float" href={waLink(num, 'Hello Edunotech, ')} target="_blank" rel="noopener" data-event="whatsapp_click" aria-label="Chat with Edunotech on WhatsApp">
    <Icon name="message" size={26} />
  </a>
)}
<style>
  .wa-float {
    position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 40; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; background: var(--emerald); color: var(--white); box-shadow: 0 10px 24px -8px rgba(0,0,0,0.35);
  }
  .wa-float:hover { background: var(--forest); color: var(--white); }
</style>
