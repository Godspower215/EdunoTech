<style>
  .net :global(svg) { width: 100%; height: auto; overflow: visible; }
  .net :global(.l) { stroke: rgba(255, 255, 255, 0.22); stroke-width: 1.4; }
  .net :global(.l.a) { stroke: var(--lime); stroke-width: 2.2; }
  .net :global(.n) { fill: rgba(255, 255, 255, 0.35); }
  .net :global(.n.h) { fill: var(--lime); }
  @media (prefers-reduced-motion: no-preference) {
    .net :global(.n.h) { animation: pulse 4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .net :global(.n.h:nth-of-type(3n)) { animation-delay: -1.3s; }
    .net :global(.n.h:nth-of-type(3n+1)) { animation-delay: -2.6s; }
    /* On load the lines draw themselves in and the dots fade up. */
    .net :global(.l) { stroke-dasharray: 1; animation: draw 1.6s var(--ease) both; animation-delay: 0.2s; }
    .net :global(.l:nth-of-type(3n)) { animation-delay: 0.45s; }
    .net :global(.l:nth-of-type(3n+1)) { animation-delay: 0.7s; }
    .net :global(svg) { animation: net-in 1.4s var(--ease) both; }
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes net-in { from { opacity: 0; scale: 0.94; } to { opacity: 1; scale: 1; } }
  @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.55; transform: scale(0.75); } }
</style>
