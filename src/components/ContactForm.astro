---
import contact from '../data/contact.json';
import FormShared from './FormShared.astro';
---
<form class="form" action="/api/submit" method="post" data-form data-event="contact_form_submit" data-success={contact.successMessage}>
  <input type="hidden" name="formType" value="contact" />
  <div class="form-row form-row--2">
    <div class="field">
      <label for="cf-name">Full Name <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-error" />
      <p class="field-error" id="cf-name-error" aria-live="polite"></p>
    </div>
    <div class="field">
      <label for="cf-email">Email Address <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-error" />
      <p class="field-error" id="cf-email-error" aria-live="polite"></p>
    </div>
  </div>
  <div class="form-row form-row--2">
    <div class="field">
      <label for="cf-org">Organisation <span class="opt">(optional)</span></label>
      <input id="cf-org" name="organisation" type="text" autocomplete="organization" maxlength="200" aria-describedby="cf-org-error" />
      <p class="field-error" id="cf-org-error" aria-live="polite"></p>
    </div>
    <div class="field">
      <label for="cf-phone">Phone Number <span class="opt">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" pattern="[0-9+()\-\s]{6,40}" aria-describedby="cf-phone-error" />
      <p class="field-error" id="cf-phone-error" aria-live="polite"></p>
    </div>
  </div>
  <div class="field">
    <label for="cf-type">Nature of Enquiry <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-type" name="enquiryType" required aria-describedby="cf-type-error">
      <option value="">Select an option</option>
      {contact.enquiryTypes.map((t) => <option value={t.value}>{t.label}</option>)}
    </select>
    <p class="field-error" id="cf-type-error" aria-live="polite"></p>
  </div>
  <div class="field">
    <label for="cf-subject">Subject <span class="req" aria-hidden="true">*</span></label>
    <input id="cf-subject" name="subject" type="text" required maxlength="200" aria-describedby="cf-subject-error" />
    <p class="field-error" id="cf-subject-error" aria-live="polite"></p>
  </div>
  <div class="field">
    <label for="cf-message">Message <span class="req" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" required minlength="10" maxlength="5000" aria-describedby="cf-message-error"></textarea>
    <p class="field-error" id="cf-message-error" aria-live="polite"></p>
  </div>
  <div class="field">
    <label class="consent" for="cf-consent">
      <input id="cf-consent" name="consent" type="checkbox" value="yes" required aria-describedby="cf-consent-error" data-required-msg="Please agree to the Privacy Policy so we can respond to you." />
      <span>I agree that Edunotech may use the information I have provided to respond to my enquiry, as described in the <a href="/privacy">Privacy Policy</a>. <span class="req" aria-hidden="true">*</span></span>
    </label>
    <p class="field-error" id="cf-consent-error" aria-live="polite"></p>
  </div>
  <FormShared />
  <div class="form-status" data-form-status role="status" tabindex="-1"></div>
  <div><button type="submit" class="btn btn--primary">Send Message</button></div>
</form>
<script>
  import { initForms } from '../scripts/forms';
  initForms();
</script>
