---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'secondary' | 'lime' | 'ghost-light'; arrow?: boolean; event?: string; }
const { href, variant = 'primary', arrow = false, event } = Astro.props;
---
<a href={href} class={`btn btn--${variant}`} data-event={event}><slot />{arrow && <Icon name="arrow-right" size={18} />}</a>
