---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import home from '../data/home.json';
import servicesData from '../data/services.json';
import pse from '../data/pse.json';

const services = servicesData.services as any[];
const hl = home.hero.headline.endsWith(home.hero.highlight ?? '\u0000') ? home.hero.highlight : '';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Edunotech',
  url: new URL('/', Astro.site).toString(),
  publisher: { '@id': new URL('/#organization', Astro.site).toString() },
};
---
<Base
  title="Edunotech | Technology and Education Company in Nigeria"
  jsonLd={[websiteLd]}
  description="Edunotech is a Nigerian technology and education company offering AI training, website development and problem-solving programmes for students."
>
  <!-- Hero: solid brand colour, bold type, network graphic -->
  <section class="hero on-dark">
    <div class="hero__net" aria-hidden="true"><HeroNetwork /></div>
    <p class="hero__side" aria-hidden="true">Bridging education, innovation and technology</p>
    <div class="container hero__inner">
      <p class="hero__chip">{home.hero.eyebrow}</p>
      <h1>{hl ? <>{home.hero.headline.slice(0, -hl.length).trimEnd()} <span>{hl}</span></> : home.hero.headline}</h1>
      <p class="hero__lead">{home.hero.text}</p>
      <div class="btn-row">
        <Button href="/services" variant="lime" arrow event="cta_hero_services">Explore Our Services</Button>
        <Button href="/contact" variant="ghost-light" event="cta_hero_work_with_us">Work With Us</Button>
      </div>
      <ol class="hero__steps" aria-label="How we work">
        {home.approach.steps.map((s) => <li>{s.title}</li>)}
      </ol>
    </div>
  </section>

  <!-- Introduction -->
  <section class="section">
    <div class="container split split--top">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>{home.intro.heading}</h2>
      </div>
      <div class="prose">
        {home.intro.paragraphs.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
        <div class="btn-row"><Button href="/about" variant="secondary" arrow>Discover Edunotech</Button></div>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section section--neutral" id="what-we-do">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>{home.whatWeDo.heading}</h2>
        <p>{home.whatWeDo.text}</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a class="card card--link service-card" href={s.cardHref ?? `/services#${s.id}`} data-event="service_card_click">
            <span class="icon-badge"><Icon name={s.icon} /></span>
            <h3>{s.homeTitle ?? s.title}</h3>
            <p>{s.cardText}</p>
            <span class="text-link">{s.cardLink} <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our approach</p>
        <h2>{home.approach.heading}</h2>
      </div>
      <Process steps={home.approach.steps} label="Edunotech's five-stage approach" />
    </div>
  </section>

  <!-- Featured programme -->
  <section class="section section--dark">
    <div class="container split">
      <div>
        <p class="eyebrow">Featured programme</p>
        <h2>{home.programme.heading}</h2>
        <p class="lead">{home.programme.lead}</p>
        {home.programme.paragraphs.map((p) => <p>{p}</p>)}
        <div class="btn-row"><Button href="/problem-solving-experience" variant="lime" arrow event="cta_pse">Explore the Experience</Button></div>
      </div>
      <div class="framework-mini" aria-label="The nine stages of the problem-solving framework">
        <ol>
          {pse.framework.map((f, i) => (
            <li><span>{String(i + 1).padStart(2, '0')}</span>{f.title}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ECIC -->
  <section class="section">
    <div class="container split">
      <ImageSlot src={home.ecic.image} alt={home.ecic.imageAlt} need={home.ecic.imagePlaceholder} ratio="5 / 4" />
      <div>
        <p class="eyebrow">Community initiative</p>
        <h2>{home.ecic.heading}</h2>
        {home.ecic.paragraphs.map((p) => <p>{p}</p>)}
        <p class="badge">An initiative powered by Edunotech</p>
        <div class="btn-row"><Button href="/ecic" arrow event="cta_ecic">Discover ECIC</Button></div>
      </div>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="section section--neutral">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Who we work with</p>
        <h2>{home.audiences.heading}</h2>
        <p>{home.audiences.text}</p>
      </div>
      <ul class="audience-grid">
        {home.audiences.items.map((a) => (
          <li><span class="icon-badge"><Icon name={a.icon} /></span>{a.title}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={home.cta.heading} text={home.cta.text}>
    <Button href="/contact" variant="lime" arrow event="cta_start_conversation">Start a Conversation</Button>
    <Button href="/services" variant="ghost-light">Explore Our Work</Button>
  </CtaBand>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--forest-2); color: var(--white);
    min-height: min(92vh, 860px); display: flex; align-items: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .hero__net { position: absolute; z-index: -1; width: min(720px, 50vw); right: -9%; top: 50%; translate: 0 -50%; }
  .hero__inner { position: relative; }
  @media (max-width: 899px) { .hero__net { width: 120vw; right: -60vw; top: 30%; opacity: 0.4; } }
  .hero__side {
    position: absolute; left: clamp(0.5rem, 2vw, 1.75rem); top: 50%; translate: 0 -50%;
    writing-mode: vertical-rl; rotate: 180deg; margin: 0;
    font-size: 0.72rem; letter-spacing: 0.35em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45);
  }
  @media (max-width: 1100px) { .hero__side { display: none; } }
  .hero__chip {
    display: inline-block; background: var(--lime); color: var(--forest); font-weight: 800; font-size: 0.78rem;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.7rem; border-radius: 4px; margin-bottom: 1.75rem;
  }
  .hero h1 {
    color: var(--white); text-transform: uppercase; font-weight: 800; letter-spacing: -0.035em; line-height: 0.98;
    font-size: clamp(2.1rem, 1.1rem + 4.2vw, 4.6rem); max-width: 17ch; margin-bottom: 1.5rem;
  }
  .hero h1 span { color: var(--lime); }
  .hero__lead { color: var(--on-dark-muted); font-size: var(--step-1); line-height: 1.55; max-width: 54ch; }
  .hero__steps {
    list-style: none; padding: 0; margin: clamp(2.5rem, 6vw, 4.5rem) 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem;
    font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55);
  }
  .hero__steps li { display: inline-flex; align-items: center; gap: 0.6rem; }
  .hero__steps li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); }

  .service-card { text-decoration: none; color: inherit; }
  .service-card h3 { color: var(--forest); }

  .framework-mini { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius); padding: clamp(1.25rem, 3vw, 2rem); }
  .framework-mini ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .framework-mini li {
    display: flex; align-items: center; gap: 1rem; padding: 0.7rem 0.25rem; color: var(--white); font-weight: 700;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.14);
  }
  .framework-mini li:last-child { border-bottom: 0; color: var(--lime); }
  .framework-mini span { font-size: 0.8rem; color: var(--lime); font-variant-numeric: tabular-nums; width: 1.6rem; }

  .audience-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .audience-grid li {
    background: var(--white); border-radius: var(--radius); padding: 1.5rem; font-weight: 700; color: var(--forest);
    display: flex; flex-direction: column; gap: 0.25rem; line-height: 1.35;
  }
</style>
