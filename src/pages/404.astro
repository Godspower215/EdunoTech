---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found | Edunotech" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow">Error 404</p>
      <h1>We could not find that page.</h1>
      <p class="lead muted">The link may be out of date, or the page may have moved.</p>
      <div class="btn-row">
        <Button href="/" arrow>Go to the homepage</Button>
        <Button href="/contact" variant="secondary">Contact us</Button>
      </div>
    </div>
  </section>
</Base>
