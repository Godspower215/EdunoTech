---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; description: string; updated: string; }
const { title, description, updated } = Astro.props;
---
<Base title={`${title} | Edunotech`} description={description}>
  <PageHero eyebrow="Legal" title={title} text={`Last updated: ${updated}`} />
  <section class="section">
    <div class="container container--narrow legal">
      <p class="draft-note" data-placeholder="legal-review">
        <strong>Draft for review.</strong> This page is a starting draft prepared for the website build. It must be reviewed
        by Edunotech, and ideally a qualified adviser, before launch so that it matches how the company actually handles data and does business.
      </p>
      <slot />
    </div>
  </section>
</Base>
<style>
  .legal :global(h2) { font-size: var(--step-2); margin-top: 2.5rem; }
  .legal :global(ul) { padding-left: 1.25rem; margin: 0 0 1rem; }
  .legal :global(li) { margin-bottom: 0.4rem; }
  .draft-note { background: #fff7d6; border: 1px dashed #c9a400; color: #4d3d00; padding: 1rem 1.15rem; border-radius: 10px; font-size: 0.95rem; }
</style>
