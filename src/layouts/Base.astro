---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  footerStatement?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, image = '/og-default.png', imageAlt = 'Edunotech logo', noindex = false, footerStatement, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '$1'), Astro.site);
const ogImage = new URL(image, Astro.site);
const home = new URL('/', Astro.site).toString();
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${home}#organization`,
  name: site.name,
  url: home,
  description: site.footerDescription,
  ...(site.logo ? { logo: new URL(site.logo, Astro.site).toString() } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  ...(site.founder ? { founder: { '@type': 'Person', name: site.founder } } : {}),
  ...((site.socials as { url: string }[]).length ? { sameAs: (site.socials as { url: string }[]).map((s) => s.url) } : {}),
};
const cfToken = site.analytics.cloudflareToken;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#123B2A" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Edunotech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    {cfToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer statement={footerStatement} />
    <WhatsAppButton />
    <script is:inline>
      // Scroll reveal and number counters. Decoration only: if this script
      // does not run, every element simply shows as normal.
      (function () {
        var mq = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
        if ((mq && mq.matches) || !('IntersectionObserver' in window)) return;
        var fine = ['.grid > *', '.process__step', '.audience-grid > li', '.stats > .stat', '.gallery > li', '.framework-mini li', '.section-head', '.cta-band', '.winner'];
        var coarse = ['.split > *', '.section > .container > *'];
        var picked = [];
        fine.concat(coarse).forEach(function (sel) {
          document.querySelectorAll('main ' + sel).forEach(function (el) {
            if (el.hasAttribute('data-rv') || el.closest('[data-rv]') || el.querySelector('[data-rv]')) return;
            el.setAttribute('data-rv', '');
            picked.push(el);
          });
        });
        var fold = window.innerHeight * 0.92;
        var finish = function (el) {
          el.classList.remove('reveal', 'is-in');
          el.style.removeProperty('--rd');
        };
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            io.unobserve(el);
            el.classList.add('is-in');
            var delay = parseInt(el.style.getPropertyValue('--rd'), 10) || 0;
            setTimeout(function () { finish(el); }, 900 + delay);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        picked.forEach(function (el) {
          // Leave anything already on screen alone, so nothing flickers.
          if (el.getBoundingClientRect().top < fold) return;
          var sibs = Array.prototype.filter.call(el.parentElement.children, function (c) { return c.hasAttribute('data-rv'); });
          var i = Math.min(sibs.indexOf(el), 5);
          if (i > 0) el.style.setProperty('--rd', i * 90 + 'ms');
          el.classList.add('reveal');
          io.observe(el);
        });
        window.addEventListener('beforeprint', function () { picked.forEach(finish); });

        // Count up figures such as "150+" in the ECIC stats.
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            var el = e.target, m = el.textContent.trim().match(/^(\d+)(.*)$/);
            if (!m) return;
            var end = parseInt(m[1], 10), rest = m[2], t0 = null, dur = 1400;
            var step = function (t) {
              if (t0 === null) t0 = t;
              var p = Math.min((t - t0) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(end * eased) + rest;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }, { threshold: 0.6 });
        document.querySelectorAll('main [data-count]').forEach(function (el) { cio.observe(el); });
      })();
    </script>
    <script>
      // CTA click tracking. Sends to whichever analytics tool is installed
      // (Cloudflare Zaraz, Plausible or GA4). Does nothing if none is set up.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-event]');
        if (!el) return;
        const w = window as any;
        const name = el.dataset.event!;
        const props = { label: el.textContent?.trim().slice(0, 80) ?? '', page: location.pathname };
        try {
          w.zaraz?.track?.(name, props);
          w.plausible?.(name, { props });
          w.gtag?.('event', name, props);
        } catch {}
      });
    </script>
  </body>
</html>
